---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HomePage from "@/components/tina/HomePage.astro";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import { islands } from "@/lib/tina/islands";
import { home as staticHome, type HomeContent } from "@/data/home";

// The GitHub Pages build is fully static with no Tina backend, so read the home
// content straight from JSON. During local development (base "/") we use the Tina client
// and island wrapper so live visual editing keeps working.
const useTinaClient = import.meta.env.DEV && process.env.TINA_PUBLIC_IS_LOCAL === "true";

let home: HomeContent = staticHome;
let useTinaEditing = false;

if (useTinaClient) {
  try {
    const { getHome } = await import("@/lib/tina/data");
    const response = await getHome();
    const tinaHome = response?.data?.home;

    if (tinaHome) {
      home = tinaHome as unknown as HomeContent;
      useTinaEditing = true;
    }
  } catch {
    // `npm run dev:site` has no Tina data server, so use committed content.
  }
}
---

<BaseLayout
  title="Carpet Cleaning Central Otago | Advanced Carpets"
  description={home.seoDescription}
  ogTitle="Carpet Cleaning Across Central Otago | Advanced Carpets"
  ogDescription="Carpet cleaning and specialist services for homes and businesses across Central Otago, Southern Lakes and the Maniototo."
  ogImage="/assets/hero-cleaning.png"
  pathname="/"
>
  {!useTinaEditing ? (
    <HomePage home={home} />
  ) : (
    <TinaIsland name="home" wrapper={islands.home.wrapper} primary>
      <HomePage home={home} />
    </TinaIsland>
  )}
</BaseLayout>
