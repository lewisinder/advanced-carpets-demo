---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { site } from "@/data/site";

const effectiveDate = "24 September 2026";
const description = "Privacy policy for Advanced Carpets & Restoration, including the information collected through our website and Tradify enquiry form.";
---

<BaseLayout title={`Privacy Policy | ${site.name}`} description={description} pathname="/privacy-policy">
  <PageHero title="Privacy policy" copy={`How Advanced Carpets & Restoration handles information you send through this website and our enquiry form. Effective ${effectiveDate}.`} />

  <section class="section section-white privacy-section">
    <div class="container privacy-layout">
      <aside class="privacy-summary">
        <p class="overline orange">At a glance</p>
        <h2>Clear and practical</h2>
        <p>We collect the details we need to respond to your enquiry and provide our services. We do not currently use Google Analytics, Microsoft Clarity or advertising trackers on this website.</p>
        <a class="text-link" href={`mailto:${site.email}`}>Contact us about privacy</a>
      </aside>

      <div class="privacy-content">
        <section>
          <h2>Who we are</h2>
          <p>Advanced Carpets &amp; Restoration is a New Zealand business based in Cromwell. This policy explains how we handle personal information in line with the Privacy Act 2020.</p>
          <p>For privacy questions, access requests or correction requests, contact <a href={`mailto:${site.email}`}>{site.email}</a> or call <a href="tel:021333354">{site.primaryPhone}</a>.</p>
        </section>

        <section>
          <h2>Information we collect</h2>
          <p>We may collect information you choose to send us, including:</p>
          <ul>
            <li>Your name, phone number and email address.</li>
            <li>The property address and details about the service you are asking about.</li>
            <li>Photos, notes and other information you include with an enquiry.</li>
            <li>Information from later phone calls, emails, visits or work records.</li>
          </ul>
          <p>Our website may also receive basic technical information needed to deliver and secure a web page, such as an IP address, browser type and device information. We do not currently use this website for behavioural profiling or targeted advertising.</p>
        </section>

        <section>
          <h2>How we use your information</h2>
          <ul>
            <li>To respond to your enquiry and arrange a suitable next step.</li>
            <li>To contact you about the property, service or job you have asked about.</li>
            <li>To provide, document and improve our services.</li>
            <li>To communicate with an insurer or another relevant party where you ask us to, or where it is needed to carry out the work.</li>
            <li>To keep business, safety, accounting and legal records.</li>
          </ul>
          <p>We do not sell your personal information or use it to build advertising profiles.</p>
        </section>

        <section>
          <h2>Tradify enquiry form</h2>
          <p>The enquiry form on this website is supplied through Tradify and is embedded from TradeHQ. Information you submit through the form is sent to Tradify so that we can receive and manage your enquiry.</p>
          <p>Tradify may process information under its own privacy policy and may use technical storage or cookies needed to operate its form. Read the <a href="https://www.tradifyhq.com/tradehq/privacy" target="_blank" rel="noopener noreferrer">Tradify privacy policy</a> for information about its handling of data.</p>
        </section>

        <section>
          <h2>Cookies and tracking</h2>
          <p>We do not currently set optional analytics, marketing or advertising cookies on this website. We do not use Google Analytics or Microsoft Clarity.</p>
          <p>The embedded Tradify form is a separate service and may use essential cookies or similar technical storage. If we add optional analytics or marketing tools in the future, we will update this policy and provide any controls required by law.</p>
        </section>

        <section>
          <h2>Who we share information with</h2>
          <p>We may share information with Tradify, contractors, insurers, advisers or other providers where this is necessary to respond to you, carry out the work, process a claim, protect safety or meet a legal obligation. We only share what is reasonably needed for that purpose.</p>
          <p>Some service providers may store or process information outside New Zealand. We take reasonable steps to use providers that protect information and to meet the requirements that apply to overseas disclosures under New Zealand privacy law.</p>
        </section>

        <section>
          <h2>Security and retention</h2>
          <p>We take reasonable steps to protect personal information from loss, unauthorised access, use, alteration or disclosure. No online transmission or storage system can be guaranteed completely secure.</p>
          <p>We keep information only for as long as it is needed for the purpose it was collected, for an ongoing customer relationship, or to meet accounting, insurance, safety or legal requirements. When it is no longer needed, we securely delete it or remove identifying details where practical.</p>
        </section>

        <section>
          <h2>Your rights</h2>
          <p>Under the Privacy Act 2020, you can ask for access to personal information we hold about you and ask us to correct information that is inaccurate or incomplete. Contact us using the details above. We may need to confirm your identity before responding.</p>
          <p>If you are not satisfied with how we handle a privacy concern, you can contact the <a href="https://www.privacy.org.nz/your-rights/how-to-complain/" target="_blank" rel="noopener noreferrer">Office of the Privacy Commissioner</a> in New Zealand.</p>
        </section>

        <section>
          <h2>Changes to this policy</h2>
          <p>We may update this policy when our services, suppliers or legal obligations change. The effective date at the top of this page will show when it was last updated.</p>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .privacy-section { padding-block: 84px 110px; }
  .privacy-layout { display: grid; grid-template-columns: minmax(240px, .7fr) minmax(0, 1.3fr); gap: 84px; align-items: start; }
  .privacy-summary { position: sticky; top: 118px; border-top: 5px solid var(--clay); padding-top: 22px; }
  .privacy-summary h2 { margin: 8px 0 18px; font-family: "Plus Jakarta Sans", ui-sans-serif, system-ui, sans-serif; font-size: clamp(2rem, 3vw, 3rem); font-weight: 900; letter-spacing: -.03em; line-height: 1.05; }
  .privacy-summary > p:not(.overline) { max-width: 340px; color: var(--muted); }
  .privacy-summary .text-link { display: inline-flex; min-height: 44px; align-items: center; margin-top: 18px; color: var(--water); font-weight: 850; text-decoration: underline; text-underline-offset: 4px; }
  .privacy-content { max-width: 780px; }
  .privacy-content section { border-top: 1px solid var(--line); padding-block: 28px 34px; }
  .privacy-content section:first-child { border-top: 0; padding-top: 0; }
  .privacy-content h2 { margin: 0 0 14px; color: var(--charcoal); font-family: "Plus Jakarta Sans", ui-sans-serif, system-ui, sans-serif; font-size: clamp(1.5rem, 2.2vw, 2rem); font-weight: 900; letter-spacing: -.025em; line-height: 1.15; }
  .privacy-content p { margin: 0 0 14px; color: var(--muted); }
  .privacy-content p:last-child { margin-bottom: 0; }
  .privacy-content ul { display: grid; gap: 10px; margin: 0 0 16px; padding-left: 22px; color: var(--muted); }
  .privacy-content a { color: var(--water); font-weight: 750; text-decoration: underline; text-underline-offset: 3px; }
  .privacy-content a:hover { color: var(--clay-dark); }
  @media (max-width: 900px) { .privacy-layout { grid-template-columns: 1fr; gap: 48px; } .privacy-summary { position: static; } }
  @media (max-width: 600px) { .privacy-section { padding-block: 56px 80px; } }
</style>
