---
import IicrcLogo from "@/components/IicrcLogo.astro";
import ServiceFacts, { type ServiceFact } from "@/components/ServiceFacts.astro";
import ServiceStat from "@/components/ServiceStat.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import designSystemRegistry from "@/data/design-system.json";
import { withBase } from "@/lib/base";
import homeContent from "../../content/pages/home.json";

const facts: ServiceFact[] = [
  { label: "Van-mounted equipment", icon: "truck", tone: "clay" },
  { label: "Own power and hot water", icon: "droplets", tone: "water" },
  { label: "4 to 8 hour drying time", icon: "clock", tone: "sage" },
  { label: "IICRC-certified technicians", icon: "award", tone: "taupe" },
];
const colours = [
  ["Charcoal", "--charcoal"], ["Ink", "--ink"], ["Muted", "--muted"], ["Wool", "--wool"],
  ["Paper", "--paper"], ["Clay", "--clay"], ["Logo orange", "--brand-orange"], ["Water", "--water"], ["Sage", "--sage"], ["Taupe", "--taupe"],
];
const pageOrder = ["Service hero", "Verified service facts", "Who the service suits", "What is included", "Detailed service explanation", "What to expect", "Results or proof", "Local coverage and FAQs", "Enquiry form", "Related services"];
---

<BaseLayout title="Design System | Advanced Carpets & Restoration" description="Private design system for Advanced Carpets & Restoration." pathname="/design-system" robots="noindex, nofollow">
  <main class="design-system">
    <header class="design-hero">
      <div class="container">
        <p class="overline orange">Internal reference</p>
        <h1>Advanced Carpets design system</h1>
        <p>A compact reference for keeping the website clear, credible and visually consistent.</p>
      </div>
    </header>

    <nav class="design-nav" aria-label="Design system sections">
      <div class="container"><a href="#foundations">Foundations</a><a href="#components">Components</a><a href="#patterns">Page patterns</a><a href="#rules">Rules</a></div>
    </nav>

    <section id="foundations" class="section section-white">
      <div class="container design-section">
        <div class="design-heading"><p class="overline orange">01</p><h2>Foundations</h2><p>Use the shared CSS tokens. Use logo orange for review stars and clay for actions and accents. Do not introduce near-matching colours, typefaces or spacing systems inside individual pages.</p></div>
        <div class="design-colours">{colours.map(([name, token]) => <div><span style={`--swatch: var(${token})`}></span><strong>{name}</strong><code>{token}</code></div>)}</div>
        <div class="design-type">
          <div><small>Display and headings</small><h2>Plus Jakarta Sans</h2><p>Use weights 700 to 900 with compact line-height.</p></div>
          <div><small>Body and interface copy</small><p class="design-body-sample">Source Sans 3 keeps service information readable at every screen size.</p><p>Default body size is 17px with relaxed line-height.</p></div>
        </div>
      </div>
    </section>

    <section id="components" class="section">
      <div class="container design-section">
        <div class="design-heading"><p class="overline orange">02</p><h2>Core components</h2><p>Reuse the established components and classes. Variations should change content, not create a second visual language.</p></div>

        <article class="design-block">
          <h3>Actions</h3>
          <p>The primary written action is <strong>Make an enquiry</strong>. Use <strong>Estimate the cost</strong> as the secondary planning action when the customer may want an indicative cost before sending job details. Phone links are the direct action for urgent help.</p>
          <div class="design-actions"><a class="button button-primary" href="#">Make an enquiry</a><a class="button button-outline" href={withBase("/estimator/")}>Estimate the cost</a><a class="text-link" href="#">Read more</a></div>
        </article>

        <article class="design-block">
          <h3>Icons and factual service rail</h3>
          <p>All interface icons come from <strong>Lucide</strong> through <code>@lucide/astro</code>, imported from individual icon files. Use an official brand asset or a locally maintained matching SVG only when Lucide has no suitable icon. Do not mix icon libraries or use emoji.</p>
          <p>The service rail uses short, verified facts specific to the service. Do not use generic scores, percentages or invented performance claims.</p>
          <div class="design-facts"><ServiceFacts facts={facts} label="Carpet cleaning service facts example" /></div>
        </article>

        <article class="design-block">
          <h3>Certification artwork</h3>
          <p>Use the supplied IICRC artwork, choosing the light or dark variant for the background. Brand logos are never recreated as interface icons.</p>
          <div class="design-logos"><div><IicrcLogo variant="on-light" /></div><div class="dark"><IicrcLogo variant="on-dark" /></div></div>
        </article>

        <article id="component-registry" class="design-block">
          <h3>Registered components</h3>
          <p>Every shared Astro component must be registered here before it is introduced on a public page. The normal build verifies this list automatically.</p>
          <div class="design-registry">
            {designSystemRegistry.components.map((component) => (
              <div>
                <span>{component.category}</span>
                <strong>{component.name}</strong>
                <p>{component.description}</p>
                <code>{component.file}</code>
              </div>
            ))}
          </div>
        </article>
      </div>
    </section>

    <section id="patterns" class="section section-white">
      <div class="container design-section">
        <div class="design-heading"><p class="overline orange">03</p><h2>Page patterns</h2><p>The homepage sets the shared rhythm. Service pages use the same components, spacing and interaction rules.</p></div>

        <article class="design-block">
          <h3>Numbered process</h3>
          <p>Use the homepage pattern everywhere, including the clay, water, sage and taupe accents. On service pages, place a short line below “What to expect” to make clear that the steps describe our process. Steps are not separate cards: their backgrounds stay transparent and inherit the surrounding section surface, while the coloured rules provide the hierarchy.</p>
          <div class="steps-grid design-steps">{homeContent.steps.map((step, index) => <article><span>{index + 1}</span><h3>{step.title}</h3><p>{step.text}</p></article>)}</div>
        </article>

        <article class="design-block">
          <h3>Before and after comparisons</h3>
          <p>Only show a comparison when both images are from the same job and service. Desktop pointer movement follows the cursor. Touch users drag the slider, and keyboard users use the range control. Do not add separate Before or After tags.</p>
        </article>

        <article class="design-block">
          <h3>Service-specific figure</h3>
          <p>Use a prominent number only when the client has supplied the claim and it helps explain the service. Place it in the results section with a label that says exactly what it measures. A potential efficiency loss is not a promised improvement after cleaning.</p>
          <div class="design-stat-example"><ServiceStat eyebrow="Up to" value="30%" label="Potential efficiency loss from dirty solar panels" detail="Dirty panels can cause you to lose up to 30% efficiency, depending on the situation." /></div>
        </article>

        <article class="design-block">
          <h3>Service media frames</h3>
          <p>Align hero text with the shared page container. Service-page images fill clipped responsive frames with <code>object-fit: cover</code>. If a supplied photograph is sideways, set its rotation in the service data so it displays upright inside the same frame. The hero has a minimum height and may grow for longer copy. Work and technical photos retain set frame heights, so source aspect ratios and long text cannot push an image over the next section. Keep the shared radius and accent edge treatment. A single extra detail section uses the reading column instead of leaving an empty half-grid.</p>
        </article>

        <article class="design-block">
          <h3>Company work gallery</h3>
          <p>Use a maximum of eight selected company photographs in square frames with the shared radius. The photographs form a continuously moving horizontal rail, duplicated visually to create a seamless loop while the duplicate set stays hidden from assistive technology. Pause the rail while it is off screen. When reduced motion is requested, stop the animation, remove the duplicate set and leave the original photographs available in a horizontally scrollable rail.</p>
        </article>

        <article class="design-block">
          <h3>Service-page order</h3>
          <ol class="design-order">{pageOrder.map((item) => <li>{item}</li>)}</ol>
          <p class="design-note">The shared <code>ServicePage.astro</code> component is the layout source of truth. Keep service-specific facts, reasons, included work, limits, four step titles and descriptions, images and related links in service data. Show only facts and proof that fit the service. When no result image or review is available, use a short, useful explanation instead of repeating an earlier assurance paragraph. <a class="text-link" href={withBase("/service-page-template/")}>Open the private carpet-cleaning approval example</a>.</p>
        </article>
      </div>
    </section>

    <section id="rules" class="section section-dark">
      <div class="container design-section">
        <div class="design-heading"><p class="overline orange">04</p><h2>Simple rules</h2></div>
        <div class="design-rules">
          <div><h3>Content</h3><ul><li>Write as “we” unless a named customer review is being reproduced.</li><li>Use “Central Otago, Southern Lakes and the Maniototo” consistently.</li><li>Use only supplied, verified claims and review details.</li><li>Remove internal instructions and placeholder copy before publishing.</li></ul></div>
          <div><h3>Layout and behaviour</h3><ul><li>Register shared components before adding them to public pages.</li><li>Run <code>npm run check:design-system</code> before completing frontend work.</li><li>Use the shared container, typography, buttons and spacing tokens.</li><li>Use 1100px, 900px and 600px as the standard responsive breakpoints.</li><li>Keep mobile sticky actions compact and clear of page content.</li><li>Respect reduced-motion preferences and preserve keyboard access.</li></ul></div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .design-system h1, .design-system h2, .design-system h3 { font-family: "Plus Jakarta Sans", ui-sans-serif, system-ui, sans-serif; font-weight: 900; letter-spacing: -.025em; }
  .design-hero { background: var(--charcoal); padding: 88px 0; color: var(--white); }
  .design-hero h1 { max-width: 780px; margin: 10px 0 18px; font-size: clamp(2.7rem, 6vw, 5.6rem); line-height: .98; }
  .design-hero > .container > p:last-child { max-width: 660px; margin: 0; color: rgba(255,255,255,.72); font-size: 21px; }
  .design-nav { position: sticky; top: 86px; z-index: 10; border-bottom: 1px solid var(--line); background: rgba(255,253,248,.96); }
  .design-nav .container { display: flex; gap: 26px; overflow-x: auto; padding-block: 16px; font-weight: 800; white-space: nowrap; }
  .design-nav a:hover { color: var(--clay); }
  .design-section { display: grid; gap: 44px; }
  .design-heading { max-width: 760px; }
  .design-heading h2 { margin: 6px 0 16px; font-size: clamp(2.3rem, 4vw, 4rem); line-height: 1; }
  .design-heading > p:last-child { color: var(--muted); font-size: 19px; }
  .design-colours { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border: 1px solid var(--line); }
  .design-colours > div { display: grid; grid-template-columns: 52px 1fr; gap: 2px 14px; align-items: center; min-height: 92px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 16px; }
  .design-colours span { grid-row: 1 / 3; width: 52px; height: 52px; border: 1px solid var(--line); background: var(--swatch); }
  .design-colours code { color: var(--muted); font-size: 13px; }
  .design-type, .design-rules { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--line); }
  .design-type > div, .design-rules > div { padding: 32px 34px 0 0; }
  .design-type > div + div, .design-rules > div + div { border-left: 1px solid var(--line); padding-right: 0; padding-left: 34px; }
  .design-type h2 { margin: 12px 0; font-size: 36px; }
  .design-body-sample { max-width: 540px; font-size: 24px; }
  .design-block { border-top: 1px solid var(--line); padding-top: 34px; }
  .design-block > h3 { margin: 0 0 10px; font-size: 28px; }
  .design-block > p { max-width: 820px; color: var(--muted); }
  .design-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 24px; }
  .design-facts { margin-top: 28px; border-block: 1px solid var(--line); background: var(--paper); }
  .design-logos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 24px; border: 1px solid var(--line); }
  .design-logos > div { display: grid; min-height: 150px; place-items: center; padding: 30px; }
  .design-logos .dark { background: var(--charcoal); }
  .design-steps { margin-top: 30px; }
  .design-stat-example { margin-top: 26px; background: var(--charcoal); padding: 28px 34px; }
  .design-registry { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 28px; border-top: 1px solid var(--line); }
  .design-registry > div { min-width: 0; border-bottom: 1px solid var(--line); padding: 22px 28px 22px 0; }
  .design-registry > div:nth-child(even) { border-left: 1px solid var(--line); padding-right: 0; padding-left: 28px; }
  .design-registry span { display: block; color: var(--clay); font-size: 12px; font-weight: 900; text-transform: uppercase; }
  .design-registry strong { display: block; margin-top: 6px; font-family: "Plus Jakarta Sans", ui-sans-serif, system-ui, sans-serif; font-size: 20px; }
  .design-registry p { margin: 8px 0; color: var(--muted); }
  .design-registry code { overflow-wrap: anywhere; color: var(--water); font-size: 12px; }
  .design-order { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); counter-reset: order; margin: 24px 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .design-order li { counter-increment: order; border-bottom: 1px solid var(--line); padding: 16px 20px 16px 52px; position: relative; }
  .design-order li::before { content: counter(order, decimal-leading-zero); position: absolute; left: 0; color: var(--clay); font-weight: 900; }
  .design-note { padding: 20px; border-left: 5px solid var(--water); background: var(--water-soft); }
  .section-dark .design-heading h2, .section-dark .design-rules h3 { color: var(--white); }
  .section-dark .design-rules { border-color: rgba(255,255,255,.2); }
  .section-dark .design-rules > div + div { border-color: rgba(255,255,255,.2); }
  .section-dark li { color: rgba(255,255,255,.74); }
  .design-rules ul { display: grid; gap: 12px; padding-left: 20px; }
  @media (max-width: 900px) { .design-colours { grid-template-columns: repeat(2, minmax(0, 1fr)); } .design-nav { top: 0; } .design-type, .design-rules { grid-template-columns: 1fr; } .design-type > div + div, .design-rules > div + div { border-top: 1px solid var(--line); border-left: 0; padding-left: 0; } }
  @media (max-width: 600px) { .design-registry { grid-template-columns: 1fr; } .design-registry > div:nth-child(even) { border-left: 0; padding-left: 0; } .design-hero { padding: 60px 0; } .design-colours, .design-logos, .design-order { grid-template-columns: 1fr; } .design-colours > div { border-right: 0; } .design-nav .container { gap: 18px; } .design-stat-example { padding: 24px; } }
</style>
