---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import CTA from "@/components/CTA.astro";
import { withBase } from "@/lib/base";

const description = "About Advanced Carpets & Restoration, serving homes and businesses across Central Otago, Southern Lakes and the Maniototo.";
---

<BaseLayout title="About Advanced Carpets & Restoration" description={description} pathname="/about">
  <PageHero title="16+ years serving homes and businesses" copy="We provide cleaning, restoration and specialist property services across Central Otago, Southern Lakes and the Maniototo." />
  <section class="section section-white">
    <div class="container two-col">
      <div class="media-block">
        <img src={withBase("/assets/carpet-extraction.jpg")} alt="Commercial carpet cleaning equipment in use" />
        <p>Commercial cleaning equipment at work at a local property.</p>
      </div>
      <div>
        <div class="section-heading">
          <p class="overline orange">About us</p>
          <h2>Local experience and practical advice</h2>
        </div>
        <p class="copy">We have worked throughout the regions for more than 16 years, helping homeowners and businesses with carpet cleaning, upholstery cleaning, stain treatment, flood restoration and selected specialist services.</p>
        <p class="copy">Our technicians are IICRC certified and our work is fully insured. We use commercial equipment, check the material and condition before starting, and explain what is realistic for the job.</p>
        <p class="copy">We are based in Cromwell and service Cromwell, Alexandra, Clyde, Queenstown, Wanaka, Hāwea, Ranfurly and the places within the wider regions.</p>
      </div>
    </div>
  </section>
  <CTA />
</BaseLayout>
