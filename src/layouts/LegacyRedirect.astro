---
import { site, siteIndexing } from "@/data/site";
import { withBase } from "@/lib/base";

type Props = { destination: string };

const destination = Astro.props.destination;
const destinationOnThisHost = withBase(destination);
const canonical = `${site.url}${destination}`;
---

<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${destinationOnThisHost}`} />
    <meta name="robots" content={siteIndexing.robots} />
    <link rel="canonical" href={canonical} />
    <title>Page moved | {site.name}</title>
  </head>
  <body>
    <p>This page has moved. <a href={destinationOnThisHost}>Continue to the current page</a>.</p>
  </body>
</html>
