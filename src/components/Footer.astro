---
import { services } from "@/data/services";
import { site } from "@/data/site";
import { withBase } from "@/lib/base";
import SocialIcon from "@/components/icons/SocialIcon.astro";

const footerAreas = ["Cromwell", "Alexandra", "Queenstown", "Wanaka", "Central Otago", "Southern Lakes", "Maniototo"];
const phoneHref = (value: string) => `tel:${value.replaceAll(" ", "")}`;
---

<footer class="footer">
  <div class="container footer-grid">
    <div>
      <a class="footer-logo" href={withBase("/")} aria-label="Advanced Carpets & Restoration home">
        <img src={withBase("/assets/logo.png")} alt={site.name} width="500" height="234" />
      </a>
      <p>Cromwell-based carpet cleaning and specialist services for homes and businesses across Central Otago, Southern Lakes and the Maniototo.</p>
      <p class="footer-hours">Normal hours 9am to 5pm every day. Flood emergencies 24/7.</p>
      <nav class="footer-social" aria-label="Social media">
        <a href="https://www.facebook.com/p/Advanced-Carpets-Restoration-100063568390888/" target="_blank" rel="noopener noreferrer" aria-label="Advanced Carpets & Restoration on Facebook">
          <SocialIcon name="facebook" />
        </a>
        <a href="https://www.instagram.com/advancedcarpetscentralotago/" target="_blank" rel="noopener noreferrer" aria-label="Advanced Carpets & Restoration on Instagram">
          <SocialIcon name="instagram" />
        </a>
      </nav>
    </div>
    <div>
      <strong>Services</strong>
      {services.map((service) => (
        <a href={withBase(`/services/${service.slug}/`)}>{service.name}</a>
      ))}
    </div>
    <div>
      <strong>Locations</strong>
      {footerAreas.map((area) => <span>{area}</span>)}
    </div>
    <div>
      <strong>Contact</strong>
      {site.phones.map((phone) => <a href={phoneHref(phone.value)}>{phone.label}: {phone.value}</a>)}
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={withBase("/contact/")}>Make an enquiry</a>
    </div>
  </div>
  <div class="container footer-legal">
    <span>© 2010 - {new Date().getFullYear()} {site.name}</span>
    <a href={withBase("/privacy-policy/")}>Privacy policy</a>
    <a href="https://theblueprintcollective.co.nz/">Website Created By The Blueprint Collective</a>
  </div>
</footer>
