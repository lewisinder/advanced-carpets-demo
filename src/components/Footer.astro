---
import { services } from "@/data/services";
import { site } from "@/data/site";
import { withBase } from "@/lib/base";

const footerAreas = ["Cromwell", "Alexandra", "Queenstown", "Wanaka", "Central Otago", "Southern Lakes", "Maniototo"];
const phoneHref = (value: string) => `tel:${value.replaceAll(" ", "")}`;
---

<footer class="footer">
  <div class="container footer-grid">
    <div>
      <a class="footer-logo" href={withBase("/")} aria-label="Advanced Carpets & Restoration home">
        <img src={withBase("/assets/logo.png")} alt={site.name} width="500" height="234" />
      </a>
      <p>Cromwell-based carpet cleaning and specialist services for homes and businesses across Central Otago, Southern Lakes and the Maniototo.</p>
      <p class="footer-hours">Normal hours 9am to 5pm every day. Flood emergencies 24/7.</p>
    </div>
    <div>
      <strong>Services</strong>
      {services.map((service) => (
        <a href={withBase(`/services/${service.slug}/`)}>{service.name}</a>
      ))}
    </div>
    <div>
      <strong>Locations</strong>
      {footerAreas.map((area) => <span>{area}</span>)}
    </div>
    <div>
      <strong>Contact</strong>
      {site.phones.map((phone) => <a href={phoneHref(phone.value)}>{phone.label}: {phone.value}</a>)}
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={withBase("/contact/")}>Make an enquiry</a>
    </div>
  </div>
</footer>
