---
import BeforeAfter from "@/components/BeforeAfter.astro";
import ContactForm from "@/components/ContactForm.astro";
import FaqItem from "@/components/FaqItem.astro";
import ServiceFacts from "@/components/ServiceFacts.astro";
import { services, type Service } from "@/data/services";
import { site } from "@/data/site";
import { withBase } from "@/lib/base";
import homeContent from "../../content/pages/home.json";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import Phone from "@lucide/astro/icons/phone";
import ShieldCheck from "@lucide/astro/icons/shield-check";

type Props = { service: Service };
const { service } = Astro.props;
const phoneHref = `tel:${site.primaryPhone.replaceAll(" ", "")}`;
const lowerName = service.name.toLowerCase();
const regionName = "Central Otago, Southern Lakes and the Maniototo";
const detailSections = service.sections ?? [];
const featuredDetail = detailSections[0];
const extraDetails = detailSections.slice(1);
const relatedServices = service.relatedSlugs.map((slug) => services.find((item) => item.slug === slug)).filter((item): item is Service => Boolean(item));
const review = homeContent.reviews.find((item) => item.name === service.reviewName);
const comparison = service.comparison;
const media = service.media;
const technicalMedia = media.technical ?? media.hero;
const technicalAlt = media.technicalAlt ?? media.heroAlt;
---

<article class="service-page-page">
  <section class="service-page-hero">
    <div class="service-page-hero__grid">
      <div class="service-page-hero__content">
        <nav class="service-page-breadcrumbs" aria-label="Breadcrumb">
          <a href={withBase("/")}>Home</a><span aria-hidden="true">/</span>
          <a href={withBase("/services/")}>Services</a><span aria-hidden="true">/</span>
          <span aria-current="page">{service.name}</span>
        </nav>
        <h1>{service.heroHeading ?? `${service.name} across ${regionName}`}</h1>
        <p>{service.intro}</p>
        <div class="service-page-hero__actions">
          <a class="button button-primary" href="#service-enquiry">Make an enquiry</a>
          <a class="button button-outline" href={phoneHref}><Phone size={18} stroke-width={2.2} aria-hidden="true" />Call {site.primaryPhone}</a>
        </div>
        <div class="service-page-rating" aria-label="Rated 5 out of 5 from 10 Google reviews">
          <img src={withBase("/assets/google-g.svg")} alt="" width="26" height="26" />
          <strong>5.0</strong><span class="service-page-stars" aria-hidden="true">★★★★★</span><span>10 Google reviews</span>
        </div>
      </div>
      <div class:list={["service-page-hero__media", media.heroRotation && "service-page-media--rotated", media.heroRotation && `service-page-media--rotate-${media.heroRotation}`]}>
        <img src={withBase(media.hero)} alt={media.heroAlt} fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="service-page-facts">
    <div class="container"><ServiceFacts facts={service.facts} label={`${service.name} service facts`} /></div>
  </section>

  <section class="service-page-section service-page-fit">
    <div class="container service-page-fit__grid">
      <div>
        <h2>Is {lowerName} right for your property?</h2>
        <p class="service-page-lead">{service.overview}</p>
        <a class="service-page-text-link" href="#service-enquiry">Tell us what you need<ArrowRight size={18} stroke-width={2} aria-hidden="true" /></a>
      </div>
      <div class="service-page-fit__lists">
        <div><h3>Common reasons to arrange this service</h3><ul>{service.reasons.map((item) => <li>{item}</li>)}</ul></div>
        <div><h3>Suitable properties and situations</h3><ul>{service.useCases.map((item) => <li>{item}</li>)}</ul></div>
      </div>
    </div>
  </section>

  <section class="service-page-section service-page-includes">
    <div class="container service-page-includes__grid">
      <figure class:list={["service-page-work-photo", media.workRotation && "service-page-media--rotated", media.workRotation && `service-page-media--rotate-${media.workRotation}`]}><img src={withBase(media.work)} alt={media.workAlt} loading="lazy" /></figure>
      <div>
        <h2>What our {lowerName} service includes</h2>
        <div class="service-page-scope-list">{service.included.map((item) => <div><strong>{item}</strong></div>)}</div>
        {service.exclusions?.length ? <p class="service-page-scope-note"><strong>Good to know:</strong> {service.exclusions.join(" ")}</p> : null}
      </div>
    </div>
  </section>

  {featuredDetail && (
    <section class="service-page-technical">
      <div class="container service-page-technical__grid">
        <div class="service-page-technical__copy">
          <h2>{featuredDetail.heading}</h2>
          {featuredDetail.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
          {featuredDetail.bullets?.length ? <ul class="service-page-detail-list">{featuredDetail.bullets.map((item) => <li>{item}</li>)}</ul> : null}
          <aside class="service-page-limit-note"><ShieldCheck size={26} stroke-width={1.8} aria-hidden="true" /><p>{service.whyAdvanced}</p></aside>
          <a class="button button-primary" href="#service-enquiry">Make an enquiry</a>
        </div>
        <div class:list={["service-page-technical__media", media.technicalRotation && "service-page-media--rotated", media.technicalRotation && `service-page-media--rotate-${media.technicalRotation}`]}><img src={withBase(technicalMedia)} alt={technicalAlt} loading="lazy" /></div>
      </div>
    </section>
  )}

  {extraDetails.length > 0 && (
    <section class="service-page-section service-page-more-detail">
      <div class="container">
        <h2>More about {lowerName}</h2>
        <div class:list={["service-page-more-detail__grid", extraDetails.length === 1 && "service-page-more-detail__grid--single"]}>
          {extraDetails.map((section) => <article><h3>{section.heading}</h3>{section.paragraphs?.map((p) => <p>{p}</p>)}{section.bullets?.length ? <ul>{section.bullets.map((item) => <li>{item}</li>)}</ul> : null}</article>)}
        </div>
      </div>
    </section>
  )}

  <section class="service-page-section service-page-process">
    <div class="container">
      <h2>What to expect</h2>
      <p class="service-page-process__intro">How we carry out the work, step by step.</p>
      <div class="steps-grid">
        {service.process.map((step, index) => <article><span>{index + 1}</span><h3>{step.title}</h3><p>{step.copy}</p></article>)}
      </div>
    </div>
  </section>

  <section class="service-page-section service-page-results">
    <div class="container">
      <h2>{service.resultsHeading}</h2>
      <p class="service-page-results__intro">{service.resultsCopy}</p>
      {(comparison || review) && <div class:list={["service-page-results__grid", (!comparison || !review) && "service-page-results__grid--single"]}>
        {comparison ? <BeforeAfter beforeSrc={withBase(comparison.before)} afterSrc={withBase(comparison.after)} beforeAlt={`Before ${lowerName}`} afterAlt={`After ${lowerName}`} title={`${service.name} before and after`} caption={comparison.caption} /> : null}
        {review ? <blockquote class="service-page-review"><div class="service-page-review__source"><img src={withBase("/assets/google-g.svg")} alt="" width="28" height="28" /><span>Google review</span></div><p class="service-page-review__stars" aria-label="5 out of 5 stars">★★★★★</p><p>“{review.text}”</p><footer>{review.name}</footer></blockquote> : null}
      </div>}
      <div class="service-page-proof-line">
        <span><ShieldCheck size={20} aria-hidden="true" />16+ years serving the regions</span>
        <span><ShieldCheck size={20} aria-hidden="true" />Fully insured</span>
        <span><ShieldCheck size={20} aria-hidden="true" />IICRC-certified technicians</span>
        <span><ShieldCheck size={20} aria-hidden="true" />Homes and businesses</span>
      </div>
    </div>
  </section>

  <section class="service-page-section service-page-local-faq">
    <div class="container service-page-local-faq__grid">
      <div class="service-page-local"><h2>{service.name} throughout the regions</h2><p>We provide {lowerName} across {regionName}, including Cromwell, Alexandra, Clyde, Queenstown, Wanaka, Hāwea and Ranfurly.</p><a class="service-page-text-link" href={withBase("/#service-areas")}>View our service areas<ArrowRight size={18} stroke-width={2} aria-hidden="true" /></a></div>
      <div><h2>{service.name} questions</h2><div class="faq-list service-page-faq-list">{service.faqs.map((faq, index) => <FaqItem question={faq.question} answer={faq.answer} open={index === 0} />)}</div></div>
    </div>
  </section>

  <section id="service-enquiry" class="service-page-section service-page-enquiry">
    <div class="container service-page-enquiry__grid">
      <div class="service-page-enquiry__copy"><h2>Tell us about the {lowerName} job</h2><p>{service.enquiryCopy}</p><div class="service-page-contact-lines"><a href={phoneHref}>Call {site.primaryPhone}</a><a href={`mailto:${site.email}`}>{site.email}</a></div></div>
      <div class="service-page-form-shell"><ContactForm /></div>
    </div>
  </section>

  <section class="service-page-section service-page-related">
    <div class="container"><h2>Related services</h2><div class="service-page-related__grid">{relatedServices.map((item) => <a href={withBase(`/services/${item.slug}/`)}><span><strong>{item.name}</strong><small>{item.summary}</small></span><ArrowRight size={22} stroke-width={2} aria-hidden="true" /></a>)}</div></div>
  </section>

  <nav class="service-page-mobile-actions" aria-label="Service page actions"><a class="button button-primary" href="#service-enquiry">Make an enquiry</a><a class="service-page-mobile-actions__phone" href={phoneHref} aria-label={`Call ${site.primaryPhone}`}><Phone size={22} stroke-width={2.2} aria-hidden="true" /><span>Call</span></a></nav>
</article>

<style>
  .service-page-page {
    --service-page-heading: clamp(2.35rem, 3.7vw, 3.75rem);
    background: var(--wool);
  }

  .service-page-page h1,
  .service-page-page h2,
  .service-page-page h3 {
    margin: 0;
    color: var(--charcoal);
    font-family: "Plus Jakarta Sans", ui-sans-serif, system-ui, sans-serif;
    font-weight: 900;
    letter-spacing: -0.025em;
  }

  .service-page-page h2 {
    font-size: clamp(2rem, 3.3vw, 3.25rem);
    line-height: 1.06;
  }

  .service-page-page h3 {
    font-size: 1.2rem;
    line-height: 1.2;
  }

  .service-page-page p {
    color: var(--muted);
  }

  .service-page-section {
    padding-block: 92px;
  }

  .service-page-hero {
    overflow: hidden;
    background: var(--charcoal);
  }

  .service-page-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(460px, 0.96fr);
    max-width: 1600px;
    min-height: var(--service-media-hero-height);
    margin-inline: auto;
  }

  .service-page-hero__content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding: 58px 48px 62px max(24px, calc((min(100vw, 1600px) - var(--container)) / 2));
  }

  .service-page-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-bottom: 40px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 14px;
    font-weight: 700;
  }

  .service-page-breadcrumbs a {
    transition: color 180ms ease;
  }

  .service-page-breadcrumbs a:hover {
    color: var(--white);
  }

  .service-page-breadcrumbs span[aria-current="page"] {
    color: var(--clay);
  }

  .service-page-hero h1 {
    max-width: 760px;
    color: var(--white);
    font-size: var(--service-page-heading);
    line-height: 1.04;
  }

  .service-page-hero__content > p {
    max-width: 660px;
    margin: 26px 0 0;
    color: rgba(255, 255, 255, 0.78);
    font-size: 20px;
    line-height: 1.55;
  }

  .service-page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 34px;
  }

  .service-page-hero .button-outline {
    border-color: rgba(255, 255, 255, 0.72);
    color: var(--white);
  }

  .service-page-hero .button-outline:hover {
    border-color: var(--white);
  }

  .service-page-hero__media {
    position: relative;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    border-left: 7px solid var(--clay);
  }

  .service-page-hero__media img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 51% center;
  }

  .service-page-rating {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
    color: rgba(255, 255, 255, 0.72);
    font-size: 15px;
  }

  .service-page-rating strong {
    color: var(--white);
    font-size: 18px;
  }

  .service-page-stars {
    color: var(--brand-orange);
    font-size: 19px;
    letter-spacing: 2px;
  }

  .service-page-facts {
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }


  .service-page-fit {
    background: var(--paper);
  }

  .service-page-fit__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    gap: 88px;
    align-items: start;
  }

  .service-page-lead {
    max-width: 580px;
    margin: 24px 0 0;
    font-size: 20px;
    line-height: 1.65;
  }

  .service-page-text-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 10px;
    margin-top: 24px;
    color: var(--water);
    font-weight: 900;
    transition: color 180ms ease, gap 180ms ease;
  }

  .service-page-text-link:hover {
    gap: 14px;
    color: var(--clay-dark);
  }

  .service-page-fit__lists {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }

  .service-page-fit__lists > div {
    padding: 28px 32px 0;
  }

  .service-page-fit__lists > div + div {
    border-left: 1px solid var(--line);
  }

  .service-page-fit__lists ul {
    display: grid;
    gap: 0;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
  }

  .service-page-fit__lists li {
    border-top: 1px solid var(--line);
    padding: 13px 0;
    color: var(--muted);
    line-height: 1.45;
  }

  .service-page-includes {
    background: var(--wool);
  }

  .service-page-includes__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    gap: 72px;
    align-items: stretch;
  }

  .service-page-work-photo {
    position: relative;
    height: var(--service-media-work-height);
    min-height: 0;
    margin: 0;
    overflow: hidden;
    border-right: 7px solid var(--clay);
    border-radius: var(--radius);
    background: var(--charcoal);
  }

  .service-page-work-photo img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
  }

  .service-page-media--rotated {
    container-type: size;
  }

  .service-page-media--rotate-clockwise {
    --media-rotation: 90deg;
  }

  .service-page-media--rotate-counterclockwise {
    --media-rotation: -90deg;
  }

  .service-page-media--rotated img {
    position: absolute;
    inset: auto;
    top: 50%;
    left: 50%;
    width: 100cqh;
    height: 100cqw;
    max-width: none;
    max-height: none;
    object-fit: cover;
    object-position: center;
    transform: translate(-50%, -50%) rotate(var(--media-rotation));
  }

  .service-page-scope-list {
    display: grid;
    margin-top: 30px;
    border-top: 1px solid var(--sage);
  }

  .service-page-scope-list > div {
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }

  .service-page-scope-list strong {
    color: var(--ink);
    font-size: 18px;
  }

  .service-page-scope-list p {
    margin: 7px 0 0;
    line-height: 1.55;
  }

  .service-page-scope-note {
    margin: 22px 0 0;
    font-size: 16px;
    line-height: 1.55;
  }

  .service-page-scope-note strong { color: var(--ink); }

  .service-page-technical {
    padding-block: 0;
    background: var(--charcoal);
    color: var(--white);
  }

  .service-page-technical__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    min-height: var(--service-media-technical-height);
    align-items: center;
  }

  .service-page-technical__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 72px 72px 72px 0;
  }

  .service-page-technical h2 {
    max-width: 570px;
    color: var(--white);
  }

  .service-page-technical__copy > p {
    max-width: 620px;
    margin: 22px 0 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 18px;
    line-height: 1.65;
  }

  .service-page-limit-note {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
    max-width: 620px;
    margin-top: 28px;
    border: 1px solid rgba(20, 127, 159, 0.8);
    border-radius: 5px;
    padding: 18px 20px;
    color: var(--water);
  }

  .service-page-limit-note p {
    margin: 0;
    color: rgba(255, 255, 255, 0.78);
    line-height: 1.5;
  }

  .service-page-technical .button {
    align-self: flex-start;
    margin-top: 28px;
  }

  .service-page-technical__media {
    position: relative;
    height: var(--service-media-technical-height);
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    border-left: 7px solid var(--water);
  }

  .service-page-technical__media img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
  }

  .service-page-process {
    background: var(--wool);
  }

  .service-page-page .service-page-process__intro {
    max-width: 700px;
    margin: 16px 0 0;
    font-size: 18px;
    line-height: 1.5;
  }


  .service-page-results {
    position: relative;
    background: var(--charcoal);
    color: var(--white);
  }

  .service-page-results::before {
    position: absolute;
    top: 0;
    right: 20%;
    left: 0;
    height: 7px;
    content: "";
    background: var(--clay);
  }

  .service-page-results::after {
    position: absolute;
    top: 0;
    right: 0;
    width: 20%;
    height: 7px;
    content: "";
    background: var(--water);
  }

  .service-page-results h2 {
    color: var(--white);
  }

  .service-page-page .service-page-results__intro {
    max-width: 760px;
    margin: 18px 0 34px;
    color: rgba(255, 255, 255, 0.78);
    font-size: 19px;
    line-height: 1.5;
  }

  .service-page-results__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.65fr);
    gap: 58px;
    margin-top: 38px;
    align-items: center;
  }

  .service-page-results :global(.before-after) {
    border: 0;
    background: transparent;
    box-shadow: none;
  }

  .service-page-results :global(.before-after-frame) {
    aspect-ratio: 16 / 10;
    min-height: 430px;
    border-radius: var(--radius);
  }

  .service-page-results :global(.before-after figcaption) {
    border-top: 0;
    padding: 18px 0 0;
  }

  .service-page-results :global(.before-after figcaption strong) {
    color: var(--white);
  }

  .service-page-results :global(.before-after figcaption span) {
    color: rgba(255, 255, 255, 0.64);
  }

  .service-page-review {
    margin: 0;
    padding: 0;
  }

  .service-page-review__source {
    display: flex;
    align-items: center;
    gap: 12px;
    color: rgba(255, 255, 255, 0.64);
    font-weight: 800;
  }

  .service-page-page .service-page-review__stars {
    margin: 25px 0 18px;
    color: var(--brand-orange);
    font-size: 25px;
    letter-spacing: 4px;
  }

  .service-page-review > p:not(.service-page-review__stars) {
    margin: 0;
    color: rgba(255, 255, 255, 0.88);
    font-size: 21px;
    line-height: 1.55;
  }

  .service-page-review footer {
    margin-top: 22px;
    color: var(--white);
    font-size: 18px;
    font-weight: 900;
  }

  .service-page-proof-line {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-top: 52px;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    padding-top: 28px;
  }

  .service-page-proof-line span {
    display: flex;
    align-items: center;
    gap: 10px;
    color: rgba(255, 255, 255, 0.76);
    font-weight: 750;
  }

  .service-page-proof-line svg {
    flex: 0 0 auto;
    color: var(--sage);
  }

  .service-page-local-faq {
    background: var(--paper);
  }

  .service-page-local-faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    gap: 72px;
  }

  .service-page-local {
    border-right: 1px solid var(--line);
    padding-right: 72px;
  }

  .service-page-local p {
    margin: 24px 0 0;
    font-size: 19px;
    line-height: 1.7;
  }

  .service-page-faq-list {
    margin-top: 30px;
  }

  .service-page-enquiry {
    position: relative;
    background: var(--charcoal);
  }

  .service-page-enquiry::before {
    position: absolute;
    top: 0;
    right: 20%;
    left: 0;
    height: 7px;
    content: "";
    background: var(--clay);
  }

  .service-page-enquiry::after {
    position: absolute;
    top: 0;
    right: 0;
    width: 20%;
    height: 7px;
    content: "";
    background: var(--water);
  }

  .service-page-enquiry__grid {
    display: grid;
    grid-template-columns: minmax(300px, 0.72fr) minmax(0, 1.28fr);
    gap: 72px;
    align-items: start;
  }

  .service-page-enquiry h2 {
    color: var(--white);
  }

  .service-page-enquiry__copy > p {
    margin: 24px 0 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 19px;
    line-height: 1.65;
  }

  .service-page-contact-lines {
    display: grid;
    gap: 10px;
    margin-top: 28px;
  }

  .service-page-contact-lines a {
    color: var(--white);
