---
type Props = {
  beforeSrc: string;
  afterSrc: string;
  beforeAlt: string;
  afterAlt: string;
  title?: string;
  caption?: string;
  /** Deprecated compatibility prop. Comparison image overlays are not rendered. */
  label?: string;
};

const { beforeSrc, afterSrc, beforeAlt, afterAlt, title, caption } = Astro.props;
---

<figure class="before-after" style="--position: 50%;">
  <div class="before-after-frame">
    <img class="before-after-image before-after-image-after" src={afterSrc} alt={afterAlt} loading="lazy" />
    <img class="before-after-image before-after-image-before" src={beforeSrc} alt={beforeAlt} loading="lazy" />
    <span class="before-after-handle" aria-hidden="true"></span>
    <input class="before-after-slider" type="range" min="0" max="100" value="50" aria-label={`Drag to compare before and after${title ? ` for ${title}` : ""}`} />
  </div>
  {title && (
    <figcaption>
      <strong>{title}</strong>
      {caption && <span>{caption}</span>}
    </figcaption>
  )}
</figure>

<script is:inline>
  (() => {
    document.querySelectorAll(".before-after").forEach((root) => {
      if (root.dataset.beforeAfterReady === "true") return;
      root.dataset.beforeAfterReady = "true";
      const slider = root.querySelector(".before-after-slider");
      const frame = root.querySelector(".before-after-frame");
      if (!slider || !frame) return;
      let activePointerId = null;
      const update = () => root.style.setProperty("--position", `${slider.value}%`);
      const updateFromPointer = (event) => {
        const bounds = frame.getBoundingClientRect();
        const position = ((event.clientX - bounds.left) / bounds.width) * 100;
        slider.value = String(Math.min(100, Math.max(0, position)));
        update();
      };
      const startDrag = (event) => {
        activePointerId = event.pointerId;
        updateFromPointer(event);
      };
      const continuePointer = (event) => {
        if (event.pointerType === "mouse") {
          updateFromPointer(event);
          return;
        }
        if (event.pointerId !== activePointerId) return;
        updateFromPointer(event);
      };
      const stopDrag = (event) => {
        if (event.pointerId === activePointerId) activePointerId = null;
      };
      slider.addEventListener("input", update);
      frame.addEventListener("pointerdown", startDrag);
      frame.addEventListener("pointermove", continuePointer);
      frame.addEventListener("pointerup", stopDrag);
      frame.addEventListener("pointercancel", stopDrag);
      update();
    });
  })();
</script>
