---
import { withBase } from "@/lib/base";
import { site } from "@/data/site";

const phoneHref = `tel:${site.primaryPhone.replaceAll(" ", "")}`;
---

<section class="section">
  <div class="container">
    <div class="cta-panel">
      <div>
        <h2>Need help with cleaning, pests or water damage?</h2>
        <p>Send us the job details and we will answer your enquiry the same day. For urgent assistance, call us directly.</p>
      </div>
      <div class="cta-actions">
        <a class="button button-primary" href={withBase("/contact/")}>Make an enquiry</a>
        <a class="button button-outline" href={phoneHref}>Call {site.primaryPhone}</a>
      </div>
    </div>
  </div>
</section>
