---
const tradifyEnquiryUrl = "https://tradehq.com/krkcleaningservices/enquire";
---

<div class="tradify-enquiry">
  <div class="tradify-enquiry__header">
    <div>
      <p class="overline">Enquiry details</p>
      <h2>Request an estimate</h2>
      <p>Send the job address, contact details, service notes, and photos through our enquiry form.</p>
    </div>
    <a class="button button-primary" href={tradifyEnquiryUrl} target="_blank" rel="noopener noreferrer">
      Open form
    </a>
  </div>

  <div class="tradify-enquiry__frame-wrap">
    <iframe
      src={tradifyEnquiryUrl}
      title="Advanced Carpets enquiry form"
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
    ></iframe>
  </div>
</div>

<style>
  .tradify-enquiry {
    display: grid;
    gap: 22px;
    min-width: 0;
  }

  .tradify-enquiry__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
  }

  .tradify-enquiry__header h2 {
    margin: 8px 0 8px;
    color: var(--charcoal);
    font-family: "Plus Jakarta Sans", ui-sans-serif, system-ui, sans-serif;
    font-size: clamp(28px, 4vw, 38px);
    font-weight: 900;
    line-height: 1.02;
  }

  .tradify-enquiry__header p:last-child {
    max-width: 560px;
    margin: 0;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.55;
  }

  .tradify-enquiry__header .button {
    flex: 0 0 auto;
    white-space: nowrap;
  }

  .tradify-enquiry__frame-wrap {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) - 2px);
    background: var(--white);
  }

  .tradify-enquiry iframe {
    display: block;
    width: 100%;
    height: 1050px;
    border: 0;
    margin: 0;
    padding: 0;
  }

  @media (max-width: 720px) {
    .tradify-enquiry__header {
      display: grid;
    }

    .tradify-enquiry__header .button {
      width: 100%;
      justify-content: center;
    }
  }
</style>
