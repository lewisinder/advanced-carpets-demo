---
const tradifyEnquiryUrl = "https://tradehq.com/krkcleaningservices/enquire";
---

<div class="tradify-enquiry">
  <div class="tradify-enquiry__fallback">
    <span>Prefer to use a separate window?</span>
    <a href={tradifyEnquiryUrl} target="_blank" rel="noopener noreferrer">
      Open the full-screen form
    </a>
  </div>

  <div class="tradify-enquiry__frame-wrap">
    <iframe
      src={tradifyEnquiryUrl}
      title="Advanced Carpets enquiry form"
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      scrolling="no"
    ></iframe>
  </div>
</div>

<style>
  .tradify-enquiry {
    display: grid;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) - 2px);
    background: var(--white);
  }

  .tradify-enquiry__fallback {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
    padding: 12px 16px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.4;
  }

  .tradify-enquiry__fallback a {
    color: var(--water);
    font-weight: 800;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .tradify-enquiry__fallback a:hover {
    color: var(--charcoal);
  }

  .tradify-enquiry__frame-wrap {
    min-width: 0;
  }

  .tradify-enquiry iframe {
    display: block;
    width: 100%;
    height: 1050px;
    border: 0;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }

  @media (max-width: 720px) {
    .tradify-enquiry__fallback {
      align-items: flex-start;
      justify-content: flex-start;
      flex-direction: column;
      gap: 2px;
    }
  }
</style>
