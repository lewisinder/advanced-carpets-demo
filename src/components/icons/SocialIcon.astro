---
type Props = {
  name: "facebook" | "instagram";
  size?: number;
};

const { name, size = 20 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === "facebook" ? (
    <path d="M15 21v-8h3l.5-4H15V7.5c0-1 .5-1.5 1.5-1.5H18V2.5h-2.5C12 2.5 11 4.5 11 7v2H8v4h3v8" />
  ) : (
    <>
      <rect x="2" y="2" width="20" height="20" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <path d="M18 6h.01" />
    </>
  )}
</svg>
