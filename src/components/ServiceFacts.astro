---
import Award from "@lucide/astro/icons/award";
import Building2 from "@lucide/astro/icons/building-2";
import Clock3 from "@lucide/astro/icons/clock-3";
import Droplets from "@lucide/astro/icons/droplets";
import MapPin from "@lucide/astro/icons/map-pin";
import Phone from "@lucide/astro/icons/phone";
import Search from "@lucide/astro/icons/search";
import ShieldCheck from "@lucide/astro/icons/shield-check";
import Sparkles from "@lucide/astro/icons/sparkles";
import Truck from "@lucide/astro/icons/truck";
import Wrench from "@lucide/astro/icons/wrench";

export type ServiceFact = {
  label: string;
  icon: "award" | "building" | "clock" | "droplets" | "map" | "phone" | "search" | "shield" | "sparkles" | "truck" | "wrench";
  tone?: "clay" | "water" | "sage" | "taupe";
};

type Props = {
  facts: ServiceFact[];
  label?: string;
};

const { facts, label = "Service facts" } = Astro.props;
const icons = { award: Award, building: Building2, clock: Clock3, droplets: Droplets, map: MapPin, phone: Phone, search: Search, shield: ShieldCheck, sparkles: Sparkles, truck: Truck, wrench: Wrench };
---

<div class="service-facts" aria-label={label}>
  {facts.map(({ label: factLabel, icon, tone = "water" }) => {
    const Icon = icons[icon];
    return (
      <div class={`service-fact service-fact--${tone}`}>
        <Icon size={34} stroke-width={1.8} aria-hidden="true" />
        <span>{factLabel}</span>
      </div>
    );
  })}
</div>

<style>
  .service-facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .service-fact {
    display: flex;
    min-height: 116px;
    align-items: center;
    gap: 18px;
    border-right: 1px solid var(--line);
    padding: 24px 30px;
    color: var(--water);
  }

  .service-fact:first-child { border-left: 1px solid var(--line); }
  .service-fact span { color: var(--ink); font-size: 16px; font-weight: 800; line-height: 1.3; }
  .service-fact--clay { color: var(--clay); }
  .service-fact--water { color: var(--water); }
  .service-fact--sage { color: var(--sage); }
  .service-fact--taupe { color: var(--taupe); }

  @media (max-width: 900px) {
    .service-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .service-fact:nth-child(3) { border-left: 1px solid var(--line); }
    .service-fact:nth-child(-n + 2) { border-bottom: 1px solid var(--line); }
  }

  @media (max-width: 600px) {
    .service-facts { grid-template-columns: 1fr; }
    .service-fact,
    .service-fact:first-child,
    .service-fact:nth-child(3) { min-height: 94px; border-left: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 20px 24px; }
    .service-fact:last-child { border-bottom: 0; }
  }
</style>
